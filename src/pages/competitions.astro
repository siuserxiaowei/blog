---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { competitions, RADAR_UPDATED_AT, enrichCompetitions, getCompetitionCategories } from '../data/competitions.js';
import { getCompetitionDeadlineInfo } from '../lib/competition-radar.js';

const TODAY = new Date();
const enriched = enrichCompetitions(competitions, TODAY);
const expiredCount = enriched.filter(c => c.status.kind === 'expired').length;
const urgentCount = enriched.filter(c => c.status.kind === 'urgent').length;
const activeCount = enriched.length - expiredCount;
const softwareCategories = new Set(['AI 软件', '开源开发', '数据算法', '安全攻防', '游戏创作', '创意 AI', '创业路演']);
const softwareCount = enriched.filter(c => c.status.kind !== 'expired' && softwareCategories.has(c.cat)).length;
const categories = getCompetitionCategories(enriched);
const deadlineInfo = new Map(enriched.map(c => [c.id, getCompetitionDeadlineInfo(c)]));
const workbenchRecords = enriched.map(c => {
  const deadline = deadlineInfo.get(c.id);
  return {
    id: c.id,
    name: c.name,
    fullName: c.fullName,
    org: c.org,
    rel: c.rel,
    loc: c.loc,
    date: c.date,
    tier: c.tier,
    cat: c.cat,
    match: c.match,
    suit: c.suit,
    desc: c.desc,
    strategy: c.strategy,
    audience: c.audience,
    rewards: c.rewards,
    pros: c.pros,
    cons: c.cons,
    winning: c.winning,
    timeline: c.timeline,
    sources: c.sources ?? [],
    url: c.url,
    deadline: deadline?.date ?? c.deadlineISO,
    deadlineConfidence: deadline?.confidence ?? 'legacy',
    deadlineType: deadline?.type ?? 'deadline',
    deadlineLabel: deadline?.label ?? '关键截止',
    calendarEligible: deadline?.calendarEligible ?? false,
  };
});
const serializedWorkbenchRecords = JSON.stringify(workbenchRecords)
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e')
  .replaceAll('&', '\\u0026')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
const initialCompetition = enriched[0];
const initialDeadline = initialCompetition ? deadlineInfo.get(initialCompetition.id) : null;
---

<BaseLayout title="AI 产品赛事雷达 · siuser小伟" description="面向 AI 软件、Agent、独立开发与轻硬件团队的赛事和行业活动看板。">
  <Header />

  <main class="flex-1">

    <!-- Hero -->
    <section class="mx-auto px-6 pt-16 pb-10 md:pt-24" style="max-width: var(--container-max);">
      <div class="animate-fade-in stagger-1 flex items-center gap-3 mb-3">
        <p class="section-kicker">Competition Radar</p>
        <span class="text-[10px] tracking-wider" style="font-family: var(--font-mono); color: var(--text-secondary); opacity: 0.5;">// {RADAR_UPDATED_AT} · {enriched.length} items tracked</span>
      </div>
      <h1 class="animate-fade-in stagger-2 text-3xl md:text-5xl mb-4" style="font-family: var(--font-heading); color: var(--text);">
        AI 产品 <span class="text-shimmer">赛事雷达</span>
      </h1>
      <p class="animate-fade-in stagger-3 text-base max-w-2xl leading-relaxed" style="color: var(--text-secondary);">
        面向 AI 软件、Agent、算法、安全、独立游戏、创意 AI 与小团队创业的赛事数据库。同时追踪官方站、活动平台、公众号和社群海报；硬件只保留龙虾盒子、陪伴终端等小而轻的项目。
      </p>
      <div class="animate-fade-in stagger-3 divider-accent mt-6 mb-10"></div>

      <!-- 四指标 -->
      <div class="animate-fade-in stagger-4 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <div class="metric-tile p-5">
          <div class="text-[11px] uppercase tracking-[0.18em] mb-2" style="color: var(--text-secondary); font-family: var(--font-mono);">TOTAL</div>
          <div class="text-3xl font-semibold" style="color: var(--text); font-family: var(--font-heading);">{enriched.length}</div>
          <div class="mt-1 text-xs" style="color: var(--text-secondary);">机会 / 赛题记录</div>
        </div>
        <div class="metric-tile p-5">
          <div class="text-[11px] uppercase tracking-[0.18em] mb-2" style="color: var(--text-secondary); font-family: var(--font-mono);">ACTIVE</div>
          <div id="metric-active" class="text-3xl font-semibold" style="color: var(--color-accent); font-family: var(--font-heading);">{activeCount}</div>
          <div class="mt-1 text-xs" style="color: var(--text-secondary);">现在可投 / 将开放</div>
        </div>
        <div class="metric-tile p-5 relative overflow-hidden">
          <div class="text-[11px] uppercase tracking-[0.18em] mb-2" style="color: var(--text-secondary); font-family: var(--font-mono);">SOFTWARE</div>
          <div id="metric-software" class="text-3xl font-semibold" style="color: var(--color-accent-2); font-family: var(--font-heading);">{softwareCount}</div>
          <div class="mt-1 text-xs" style="color: var(--text-secondary);">活跃软件 / 算法 / 创意</div>
        </div>
        <div class="metric-tile p-5">
          <div class="text-[11px] uppercase tracking-[0.18em] mb-2" style="color: var(--text-secondary); font-family: var(--font-mono);">URGENT</div>
          <div id="metric-urgent" class="text-3xl font-semibold" style="color: var(--color-accent-2); font-family: var(--font-heading);">{urgentCount}</div>
          <div class="mt-1 text-xs" style="color: var(--text-secondary);">14 天内截止</div>
        </div>
      </div>
    </section>

    <!-- 核心结论 -->
    <section class="mx-auto px-6 pb-10" style="max-width: var(--container-max);">
      <div class="animate-fade-in glass-card gradient-border p-7 md:p-10 grid grid-cols-1 md:grid-cols-[1.6fr_1fr] gap-8" style="border-radius: var(--radius-xl);">
        <div>
          <p class="section-kicker mb-4">// Priority Matrix</p>
          <h2 class="text-2xl md:text-4xl mb-5 leading-tight" style="font-family: var(--font-heading); color: var(--text); letter-spacing: -0.005em;">
            Shipaton <span style="color: var(--text-secondary); font-weight: 400;">›</span> 讯飞教育 AI <span style="color: var(--text-secondary); font-weight: 400;">›</span> Agent Security <span style="color: var(--text-secondary); font-weight: 400;">›</span> CCF OPC
          </h2>
          <p class="text-sm md:text-base leading-relaxed mb-6" style="color: var(--text-secondary);">
            <strong style="color: var(--color-accent);">软件主线分成三种回报</strong>：RevenueCat Shipaton 奖励真实上架、增长与收入；讯飞教育和情感数字人适合复用现有产品；Kaggle Agent Security、ARC 与 Pokémon 更偏算法和技术影响力。中国居民被排除、仅学生或仅特定地区可报的项目不会进入默认优先队列。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="pill-note"><span class="dot-accent"></span>上架变现 · Shipaton · 9-30</span>
            <span class="pill-note"><span class="dot-accent"></span>教育 Agent · 讯飞 · 9-25</span>
            <span class="pill-note"><span class="dot-accent"></span>安全研究 · Kaggle · 9-01</span>
            <span class="pill-note"><span class="dot-accent"></span>语音 Agent · CALL-E · 9-14</span>
          </div>
        </div>

        <div class="border-t md:border-t-0 md:border-l pt-6 md:pt-0 md:pl-8" style="border-color: color-mix(in srgb, var(--border) 55%, transparent);">
          <p class="section-kicker mb-4">// 14 天紧急</p>
          <ul id="urgent-list" class:list={["space-y-2.5", urgentCount === 0 && "hidden"]}>
            {enriched.filter(c => c.status.kind === 'urgent').sort((a,b)=>a.status.days-b.status.days).map(c => (
              <li>
                <button data-jump={c.id} class="urgent-chip group">
                  <span class="flex-1 text-sm font-medium truncate" style="color: var(--text);">{c.name}</span>
                  <span class="urgent-badge">{c.status.days}d</span>
                </button>
              </li>
            ))}
          </ul>
          <p id="urgent-empty" class:list={["text-sm", urgentCount > 0 && "hidden"]} style="color: var(--text-secondary);">14 天内暂无赛事截止。</p>
        </div>
      </div>
    </section>

    <!-- 筛选条 -->
    <section class="mx-auto px-6 pb-8" style="max-width: var(--container-max);">
      <div class="filter-rows">
        <div class="radar-control-grid">
          <label class="radar-field">
            <span class="section-kicker filter-label">// 搜索</span>
            <input id="radar-search" class="radar-input" type="search" placeholder="搜赛事、赛道、打法" autocomplete="off" />
          </label>
          <label class="radar-field">
            <span class="section-kicker filter-label">// 状态</span>
            <select id="radar-status" class="radar-select">
              <option value="全部">全部状态</option>
              <option value="urgent">紧急</option>
              <option value="ongoing">进行中</option>
              <option value="upcoming">即将开始</option>
              <option value="expired">已过期</option>
            </select>
          </label>
          <label class="radar-field">
            <span class="section-kicker filter-label">// 排序</span>
            <select id="radar-sort" class="radar-select">
              <option value="software-first">软件优先</option>
              <option value="urgent-first">紧急优先</option>
              <option value="match-desc">匹配度高优先</option>
              <option value="deadline-asc">截止近优先</option>
              <option value="tier-desc">等级高优先</option>
            </select>
          </label>
        </div>
        <div class="filter-row">
          <span class="section-kicker filter-label">// 分类</span>
          <div class="filter-group">
            <button type="button" data-fcat="全部" class="filter-cat filter-chip is-on" aria-pressed="true">全部</button>
            {categories.map(cat => (
              <button type="button" data-fcat={cat} class="filter-cat filter-chip" aria-pressed="false">{cat}</button>
            ))}
          </div>
        </div>
        <div class="filter-row">
          <span class="section-kicker filter-label">// 等级</span>
          <div class="filter-group">
            <button type="button" data-ftier="全部" class="filter-tier filter-chip is-on" aria-pressed="true">全部</button>
            {['S','A','B'].map(t => (
              <button type="button" data-ftier={t} class="filter-tier filter-chip" aria-pressed="false">{t} 级</button>
            ))}
          </div>
        </div>
        <div class="workbench-row">
          <div class="filter-group" aria-label="收藏筛选">
            <button type="button" id="favorites-only" class="filter-chip workbench-toggle" aria-pressed="false">
              <span aria-hidden="true">★</span>
              只看收藏
              <span id="favorite-count" class="favorite-count">0</span>
            </button>
            <button type="button" id="clear-favorites" class="filter-chip subtle-action">清空收藏</button>
            <button type="button" id="clear-filters" class="filter-chip subtle-action">清除筛选</button>
          </div>
          <p class="workbench-note">收藏只保存在当前浏览器；筛选和当前赛事会同步到网址。</p>
        </div>
        <p id="radar-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      </div>
    </section>

    <!-- 列表 + 详情 -->
    <section class="mx-auto px-6 pb-20" style="max-width: var(--container-max);">
      <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-8 lg:gap-12">
        <!-- 左侧列表 -->
        <aside>
          <div class="flex items-center justify-between px-1 mb-3">
            <span class="section-kicker">// 列表</span>
            <span id="list-count" class="text-xs" aria-live="polite" style="color: var(--text-secondary); font-family: var(--font-mono);">{enriched.length} items</span>
          </div>
          <div id="competition-list" class="competition-list space-y-5 lg:max-h-[1440px] lg:overflow-y-auto lg:pr-2">
            {enriched.map(c => (
              <article
                data-id={c.id}
                data-status={c.status.kind}
                class="cp-list-item relative"
              >
                <a
                  href={`/competitions/${encodeURIComponent(c.id)}/`}
                  data-select-competition
                  class="cp-list-select w-full text-left p-4"
                  aria-current="false"
                  aria-label={`在工作台查看 ${c.fullName}；无 JavaScript 时打开独立详情页`}
                >
                  <div class="flex items-start justify-between gap-3 mb-2 pr-9">
                    <h3 class="text-base font-semibold leading-tight truncate" style="color: var(--text); font-family: var(--font-heading);">{c.name}</h3>
                    <span class={`tier-tag tier-${c.tier}`}>{c.tier}</span>
                  </div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`status-dot status-${c.status.kind}`}></span>
                    <span data-status-label class="text-[11px]" style="color: var(--text-secondary); font-family: var(--font-mono);">{c.status.label}</span>
                    <span class="text-[11px]" style="color: var(--text-secondary); opacity: 0.5;">·</span>
                    <span class="text-[11px]" style="color: var(--text-secondary);">{c.cat}</span>
                  </div>
                  <p class="text-xs leading-relaxed line-clamp-2 mb-3" style="color: var(--text-secondary);">{c.desc}</p>
                  <div class="flex items-center justify-between pt-2 text-[11px]" style="border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent);">
                    <span style="color: var(--text-secondary); font-family: var(--font-mono); letter-spacing: 0.08em;">MATCH</span>
                    <span style="font-family: var(--font-heading); color: var(--color-accent); font-weight: 600; font-size: 14px;">{c.match.toFixed(1)}<span style="color: var(--text-secondary); font-size: 10px; font-weight: 400;"> / 10</span></span>
                  </div>
                </a>
                <button
                  type="button"
                  data-favorite={c.id}
                  class="favorite-button list-favorite"
                  aria-label={`收藏 ${c.fullName}`}
                  aria-pressed="false"
                  title="收藏到当前浏览器"
                ><span aria-hidden="true">☆</span></button>
              </article>
            ))}
          </div>
          <div id="competition-empty" class="empty-state hidden" role="status">
            <p>没有符合当前条件的赛事。</p>
            <button type="button" data-empty-reset class="summary-button">清除筛选</button>
          </div>
          <noscript>
            <p class="workbench-note mt-4">筛选与收藏需要 JavaScript；上方 184 条赛事链接仍可直接打开独立详情页。</p>
          </noscript>
        </aside>

        <!-- 右侧详情 -->
        <section id="competition-detail" class="space-y-8" aria-live="polite" aria-busy="false">
          <div id="detail-workbench" class="detail-workbench" aria-label="当前赛事快捷操作">
            <span class="section-kicker">// 当前赛事</span>
            <div class="detail-workbench-actions">
              <button
                type="button"
                id="detail-favorite"
                data-favorite={initialCompetition?.id}
                class="summary-button favorite-detail"
                aria-label={`收藏 ${initialCompetition?.fullName ?? '当前赛事'}`}
                aria-pressed="false"
              ><span aria-hidden="true">☆</span><span data-favorite-label>收藏</span></button>
              <button
                type="button"
                id="detail-export-ics"
                data-export-ics={initialCompetition?.id}
                class="summary-button"
                disabled={!initialDeadline?.calendarEligible}
                title={initialDeadline?.calendarEligible ? '下载关键截止日历' : '日期尚未确认，暂不提供日历'}
              >加入日历</button>
            </div>
          </div>
          <div id="detail-panel" class="detail-panel space-y-7">
            <div class="glass-card gradient-border p-7 md:p-11" style="border-radius: var(--radius-xl);">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 mb-8">
                <div class="flex-1 min-w-0 space-y-3">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <span id="detail-tier" class={`tier-tag tier-${initialCompetition?.tier ?? 'B'} tier-lg`}>{initialCompetition?.tier ?? '—'} 级</span>
                    <span class="pill-note"><span id="detail-status-dot" class={`status-dot status-${initialCompetition?.status.kind ?? 'unknown'}`}></span><span id="detail-status">{initialCompetition?.status.label ?? '日期待确认'}</span></span>
                    <span id="detail-reliability" class="pill-note">来源等级 {initialCompetition?.rel ?? '—'}</span>
                    <span id="detail-category" class="pill-note">{initialCompetition?.cat ?? '未分类'}</span>
                  </div>
                  <h2 id="detail-title" class="text-2xl md:text-3xl leading-tight" style="font-family: var(--font-heading); color: var(--text); letter-spacing: -0.022em;">{initialCompetition?.fullName ?? '选择一项赛事查看详情'}</h2>
                  <div class="flex flex-wrap gap-x-6 gap-y-1.5 text-sm" style="color: var(--text-secondary);">
                    <span class="flex items-center gap-1.5"><span class="opacity-50">◎</span><span id="detail-location">{initialCompetition?.loc ?? '—'}</span></span>
                    <span class="flex items-center gap-1.5"><span class="opacity-50">◷</span><span id="detail-date">{initialCompetition?.date ?? '—'}</span></span>
                    <span class="flex items-center gap-1.5"><span class="opacity-50">◆</span><span id="detail-org">{initialCompetition?.org ?? '—'}</span></span>
                  </div>
                </div>

                <div class="metric-tile px-5 py-4 flex flex-col items-center justify-center min-w-[120px]">
                  <span class="text-[10px] uppercase tracking-[0.2em]" style="color: var(--text-secondary); font-family: var(--font-mono);">Match</span>
                  <span id="detail-match" class="text-5xl font-semibold leading-none mt-1" style="color: var(--color-accent); font-family: var(--font-heading);">{initialCompetition?.match.toFixed(1) ?? '—'}</span>
                  <span class="text-[10px] mt-1" style="color: var(--text-secondary);">/ 10</span>
                  <span id="detail-suit" class="text-[11px] mt-2 px-2 py-0.5 rounded-full" style="color: var(--color-accent-2); background: color-mix(in srgb, var(--color-accent-2) 12%, transparent);">{initialCompetition?.suit ?? '—'}</span>
                </div>
              </div>

              <div class="mb-10">
                <p class="section-kicker mb-5">// 关键时间节点</p>
                <div class="timeline-track relative pt-2">
                  <div class="absolute top-4 left-1.5 right-1.5 h-px" style="background: linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 30%, transparent), color-mix(in srgb, var(--border) 80%, transparent) 55%, transparent);"></div>
                  <div id="detail-timeline" class="timeline-grid relative grid gap-2" style={`--timeline-count: ${initialCompetition?.timeline.length ?? 1}; grid-template-columns: repeat(${initialCompetition?.timeline.length ?? 1}, minmax(0, 1fr));`}>
                    {initialCompetition?.timeline.map(n => {
                      const past = new Date(n.date) < TODAY;
                      const dotClass = past ? 'past' : n.critical ? 'critical' : 'normal';
                      return (
                        <div class="flex flex-col items-center text-center min-w-0 px-1">
                          <div class={`timeline-dot ${dotClass}`}></div>
                          <p class="mt-3 mb-1 text-[11px] font-medium leading-tight" style="color: var(--text-secondary); max-width: 100%;">{n.event}</p>
                          <small class="text-[10px]" style="color: var(--text-secondary); opacity: 0.6; font-family: var(--font-mono);">{n.date}</small>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                  <p class="section-kicker mb-3">// 赛事定位</p>
                  <p id="detail-description" class="text-sm leading-relaxed p-4 rounded-[14px]" style="color: var(--text-secondary); background: color-mix(in srgb, var(--surface) 55%, transparent); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">{initialCompetition?.desc ?? ''}</p>
                </div>
                <div>
                  <p class="section-kicker mb-3">// 参赛打法</p>
                  <p id="detail-strategy" class="text-sm leading-relaxed p-4 rounded-[14px]" style="color: var(--text); background: color-mix(in srgb, var(--color-accent) 7%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);">{initialCompetition?.strategy ?? ''}</p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
                <div>
                  <p class="section-kicker mb-3">// 核心奖励 / 资源</p>
                  <div id="detail-rewards" class="flex flex-wrap gap-1.5">
                    {initialCompetition?.rewards.map(item => <span class="reward-chip">{item}</span>)}
                  </div>
                </div>
                <div>
                  <p class="section-kicker mb-3">// 评审匹配点</p>
                  <div id="detail-winning" class="flex flex-wrap gap-1.5">
                    {initialCompetition?.winning.map(item => <span class="winning-chip">{item}</span>)}
                  </div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="glass-card p-6" style="border-radius: var(--radius-lg);">
                <p class="section-kicker mb-3" style="color: var(--color-accent-2);">// + 优势</p>
                <ul id="detail-pros" class="space-y-2">
                  {initialCompetition?.pros.map(item => <li class="detail-point detail-point-pro">{item}</li>)}
                </ul>
              </div>
              <div class="glass-card p-6" style="border-radius: var(--radius-lg);">
                <p class="section-kicker mb-3" style="color: var(--color-accent);">// ! 难点 / 风险</p>
                <ul id="detail-cons" class="space-y-2">
                  {initialCompetition?.cons.map(item => <li class="detail-point detail-point-con">{item}</li>)}
                </ul>
              </div>
            </div>

            <div class="glass-card p-5 md:p-6 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6" style="border-radius: var(--radius-lg);">
              <div class="flex-1 min-w-0">
                <p class="section-kicker mb-2">// 适合谁</p>
                <p id="detail-audience" class="text-sm leading-relaxed" style="color: var(--text-secondary);">{initialCompetition?.audience ?? ''}</p>
                <div id="detail-sources" class="source-links">
                  <span class="section-kicker source-label">// 参考来源</span>
                  {initialCompetition?.sources?.map(source => (
