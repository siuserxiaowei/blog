---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const focusAreas = [
  { tag: '01', label: '客户沟通系统：AI 语音机器人' },
  { tag: '02', label: '流程协作系统：企业自动化' },
  { tag: '03', label: '内容与知识系统：生产、分发、归档' },
  { tag: '04', label: '公开工作台：判断、工具与项目证据' }
];
---

<BaseLayout title="关于 · siuser小伟" description="关于 siuser小伟，以及这个网站为什么会长成现在这样。">
  <Header />

  <main class="flex-1">

    <!-- Hero -->
    <section class="mx-auto px-6 pt-32 pb-14 md:pt-40 md:pb-20" style="max-width: var(--container-max);">
      <div class="about-hero">
        <div class="scroll-reveal about-hero-copy">
          <p class="section-kicker">About</p>
          <h1>关于我，<br/>也关于为什么要先把一条流程<br/>跑起来。</h1>
          <p class="about-lede">
            这里不是一页信息堆出来的个人介绍。<br/>
            我把业务现场的重复动作、正在做的系统和持续形成的判断，<br/>
            整理成一个能被查看、使用和复盘的公开工作台。
          </p>
        </div>

        <aside class="scroll-reveal surface-card gradient-border about-focus">
          <p class="section-kicker">Current Focus</p>
          <div class="about-focus-list">
            {focusAreas.map((item) => (
              <div class="about-focus-row">
                <span>{item.tag}</span>
                <p>{item.label}</p>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <!-- Narrative -->
    <section class="mx-auto px-6 pb-16 md:pb-20" style="max-width: var(--container-max);">
      <article class="scroll-reveal about-story">
        <p class="section-kicker">Narrative</p>
        <div class="story-copy">
          <p>我是 siuser小伟。独立开发者，做 AI 语音机器人方案，也把企业自动化、内容系统和内部工具做成可交付的业务系统。</p>
          <p>
            早些年在无锡做制造业咨询，见过工厂一线怎么算账、怎么走政策。后来转到技术方向，发现好产品总是来自「真的有人在用、真的有问题要解决」。
            现在更关心的不是展示一段“很厉害的 AI”，而是先把真实场景里的重复沟通、重复转运和重复生产，做成有人机分工、可运行、可复盘的流程。
          </p>
          <p>
            这个网站是过程的公开入口：写东西时记录真实判断，做工具时优先解决高频动作，推进服务时先跑通最小闭环。文章、工具和项目不是装饰，而是持续工作的证据。
          </p>
        </div>

        <div class="story-pillars">
          <div class="story-pillar">
            <span>Write</span>
            <p>把判断写成可被引用的日志，不是自我介绍。</p>
          </div>
          <div class="story-pillar">
            <span>Build</span>
            <p>把重复动作沉淀成工具和工作流，明确 AI 接管与人工兜底。</p>
          </div>
          <div class="story-pillar">
            <span>Ship</span>
            <p>先让一条真实流程跑起来，再根据运行记录继续迭代。</p>
          </div>
        </div>
      </article>
    </section>

    <!-- Contact -->
    <section class="mx-auto px-6 pb-24" style="max-width: var(--container-max);">
      <div class="scroll-reveal surface-card gradient-border contact-card">
        <div class="contact-lead">
          <p class="section-kicker">Contact</p>
          <h2>带着一条重复流程来，<br/>我们先判断它值不值得做。</h2>
          <p class="contact-copy">可以带着现有话术、表格、消息记录或流程描述来聊。先从一个最小闭环开始，而不是从一份很大的需求文档开始。</p>
        </div>

        <div class="contact-links">
          <a href="https://github.com/siuserxiaowei" target="_blank" rel="noopener">
            <span>GitHub</span>
            <em>@siuserxiaowei</em>
          </a>
          <a href="mailto:hi@siuserxiaowei.com?subject=%E6%83%B3%E6%8B%86%E4%B8%80%E6%9D%A1%E9%87%8D%E5%A4%8D%E6%B5%81%E7%A8%8B">
            <span>拆一条流程</span>
            <em>发邮件</em>
          </a>
          <a href="/rss.xml">
            <span>RSS</span>
            <em>订阅更新</em>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 3rem;
    align-items: start;
  }

  .about-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.22;
    letter-spacing: -0.004em;
    font-weight: 500;
    text-wrap: balance;
  }

  .about-lede {
    max-width: 44rem;
    margin-top: 1.5rem;
    color: var(--text-secondary);
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.8;
  }

  .about-focus {
    padding: 1.35rem;
    border-radius: 28px;
    display: grid;
    gap: 1rem;
  }

  .about-focus-list {
    display: grid;
    gap: 0.25rem;
  }

  .about-focus-row {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }

  .about-focus-row:first-child {
    border-top: none;
    padding-top: 0.25rem;
  }

  .about-focus-row span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .about-focus-row p {
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .about-story {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 4rem;
    align-items: start;
  }

  .story-copy {
    display: grid;
    gap: 1.2rem;
    margin-top: 1rem;
  }

  .story-copy p {
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.95;
    text-wrap: pretty;
  }

  .story-copy p:first-child {
    color: var(--text);
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .story-pillars {
    display: grid;
    gap: 1.1rem;
    margin-top: 2.3rem;
  }

  .story-pillar {
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--border));
  }

  .story-pillar span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .story-pillar p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: 3rem;
    padding: 2.5rem 2rem;
    border-radius: 28px;
  }

  .contact-lead h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.22;
    letter-spacing: -0.004em;
    font-weight: 500;
    text-wrap: balance;
  }

  .contact-copy {
    margin-top: 1rem;
    color: var(--text-secondary);
    line-height: 1.85;
  }

  .contact-links {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
    background: color-mix(in srgb, var(--surface-2) 82%, transparent);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .contact-links a:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 38%, var(--border));
  }

  .contact-links span {
    color: var(--text);
    font-weight: 600;
  }

  .contact-links em {
    color: var(--text-secondary);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .about-hero,
    .about-story,
    .contact-card {
      grid-template-columns: 1fr;
    }

    .about-hero h1 br {
      display: none;
    }

    .about-lede br {
      display: none;
    }

    .contact-lead h2 br {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const revealElements = document.querySelectorAll('.scroll-reveal');
    if (!revealElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -40px 0px' });

    revealElements.forEach((element) => observer.observe(element));
  })();
</script>
