---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import RunSheet from '../components/RunSheet.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = allPosts.slice(0, 3);
const totalPosts = allPosts.length;

const problems = [
  {
    index: '01',
    title: '重复沟通',
    copy: '咨询、通知、回访和初筛靠人一通通完成；话术、记录和后续动作很难稳定。',
    tag: '客户沟通'
  },
  {
    index: '02',
    title: '信息转运',
    copy: '表格、消息、资料与状态在不同人之间反复复制、催办、汇总，流程越跑越依赖记忆。',
    tag: '流程协作'
  },
  {
    index: '03',
    title: '内容再生产',
    copy: '选题、素材、初稿和分发每次从头开始，专家经验无法沉淀成可复用的生产系统。',
    tag: '内容与知识'
  }
];

const methodSteps = [
  {
    index: '01',
    title: '业务诊断',
    copy: '先看真实动作、输入输出、人工成本和成功标准，不为了上 AI 而上 AI。',
    detail: '场景 / 样本 / 负责人'
  },
  {
    index: '02',
    title: '最小闭环',
    copy: '用一条最小流程验证数据、话术、触发条件和异常分支，而不是先铺一个大系统。',
    detail: 'AI 接管 / 人工兜底'
  },
  {
    index: '03',
    title: '上线交接',
    copy: '把日志、通知、权限、回滚和使用说明补齐，让流程真正能被团队接住。',
    detail: '运行 / 通知 / 交接'
  },
  {
    index: '04',
    title: '运行复盘',
    copy: '根据真实运行数据调话术、调节点、调规则，把一次性交付变成持续变好的系统。',
    detail: '数据 / 异常 / 迭代'
  }
];

const systems = [
  {
    index: '01',
    label: 'Customer communication',
    title: '客户沟通系统',
    subtitle: 'AI 语音机器人 / 外呼与回访',
    copy: '让标准化电话沟通完成触达、记录、分级和回传；人工把时间留给高意向和异常情况。',
    deliverable: '话术流程 · 多轮对话 · 线索回传 · 人工接管',
    href: '/services#voice-agent'
  },
  {
    index: '02',
    label: 'Process operations',
    title: '流程协作系统',
    subtitle: '企业自动化工作流',
    copy: '把表格、表单、消息、资料与 API 接成可追踪的流程，关键状态自动到达该处理的人。',
    deliverable: '流程梳理 · 自动化节点 · 异常提醒 · 运行日志',
    href: '/services#automation-workflow'
  },
  {
    index: '03',
    label: 'Content & knowledge',
    title: '内容与知识系统',
    subtitle: '内容生产 / 分发 / 归档',
    copy: '把选题、素材、脚本、改写、发布清单和知识沉淀连成一套长期可运行的内容系统。',
    deliverable: '选题库 · 模板 · 多平台改写 · 知识归档',
    href: '/services#content-system'
  }
];

const proofs = [
  {
    index: '01',
    label: '判断日志',
    value: `${totalPosts} 篇公开文章`,
    copy: '把技术、产品与业务判断写成能被回看的过程。',
    href: '/blog'
  },
  {
    index: '02',
    label: '可用工具',
    value: '60+ 浏览器工具',
    copy: '把高频小问题固定成可以直接使用的入口。',
    href: '/tools'
  },
  {
    index: '03',
    label: '公开构建',
    value: '项目与流程拆解',
    copy: '用可见的工作过程，而不是泛泛的能力标签建立信任。',
    href: '/projects'
  }
];

const runSheetFields = [
  { label: '场景', value: '续费前的客户回访' },
  { label: '重复动作', value: '触达 · 确认 · 记录' },
  { label: 'AI 接管', value: '外呼 · 归类 · 回填' },
  { label: '人工兜底', value: '异常 / 高意向跟进' },
  { label: '成功标准', value: '记录完整，可被复盘' }
];

const emailSubject = '%E6%83%B3%E6%8B%86%E4%B8%80%E6%9D%A1%E9%87%8D%E5%A4%8D%E6%B5%81%E7%A8%8B';
const contactHref = `mailto:hi@siuserxiaowei.com?subject=${emailSubject}`;
---

<BaseLayout
  title="siuser小伟 · 让 AI 在业务里跑起来"
  description="siuser小伟把重复沟通、流程转运和内容生产，拆成有人机分工、可上线、可复盘的 AI 业务系统。"
>
  <Header />

  <main class="flex-1">
    <section id="home" class="container hero-section">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="animate-fade-in stagger-1 section-kicker">AI BUSINESS SYSTEMS · PUBLIC WORKBENCH</p>

          <h1 class="animate-fade-in stagger-2 hero-title display-serif">
            让 AI 在<em>业务里</em>跑起来，<br />
            而不只停在演示里。
          </h1>

          <p class="animate-fade-in stagger-3 hero-lede">
            我把重复沟通、流程转运和内容生产，拆成有人机分工、可上线、可复盘的业务工作流。
            先跑通一条真实流程，再把它做成团队接得住的系统。
          </p>

          <div class="animate-fade-in stagger-4 hero-actions">
            <a href={contactHref} class="btn-primary">带着一条重复流程来聊 <span>→</span></a>
            <a href="#method" class="btn-ghost">看我怎么拆 <span>↓</span></a>
          </div>

          <p class="hero-note animate-fade-in stagger-5">
            <span>不是卖魔法</span>
            <i></i>
            <span>是先跑通一条真实流程</span>
          </p>
        </div>

        <div class="hero-ticket animate-fade-in stagger-3">
          <RunSheet
            title="客户回访 / 每日任务"
            summary="一张“流程运行单”示意：先把任务的边界、分工和成功标准写清楚。"
            fields={runSheetFields}
            status="示意运行中"
          />
        </div>
      </div>
    </section>

    <section id="problems" class="container section-block problem-section">
      <div class="section-heading narrow-heading">
        <p class="section-kicker">START WITH THE FRICTION</p>
        <h2 class="display-serif section-title">不是所有事情都该 AI 化。<br />先看<strong>哪一段重复，正在拖慢业务。</strong></h2>
      </div>

      <div class="problem-grid">
        {problems.map((problem) => (
          <article class="problem-card scroll-reveal">
            <div class="problem-meta">
              <span>{problem.index}</span>
              <span>{problem.tag}</span>
            </div>
            <h3 class="display-serif">{problem.title}</h3>
            <p>{problem.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="method" class="container section-block method-section">
      <div class="section-heading method-heading">
        <div>
          <p class="section-kicker">FROM FIELD TO SYSTEM</p>
          <h2 class="display-serif section-title">把一个问题，走成一条<br /><em>能持续运行</em>的流程。</h2>
        </div>
        <p>核心不是“接上模型”这一刻，而是把 AI 做什么、人保留什么、异常怎么处理和怎样验收都提前写进系统。</p>
      </div>

      <ol class="method-list">
        {methodSteps.map((step) => (
          <li class="method-step scroll-reveal">
            <span class="method-index">{step.index}</span>
            <div>
              <h3 class="display-serif">{step.title}</h3>
              <p>{step.copy}</p>
            </div>
            <span class="method-detail">{step.detail}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id="services" class="container section-block systems-section">
      <div class="section-heading systems-heading">
        <div>
          <p class="section-kicker">SYSTEM PATHS</p>
          <h2 class="display-serif section-title">三条常见的<br />业务系统路径。</h2>
        </div>
        <p>内部工具与数据看板是承载层：它们服务于一条已经跑通的沟通、协作或内容流程，而不是为了多做一个页面。</p>
      </div>

      <div class="systems-list">
        {systems.map((system) => (
          <a href={system.href} class="system-card scroll-reveal">
            <span class="system-index">{system.index}</span>
            <div class="system-main">
              <p class="system-label">{system.label}</p>
              <h3 class="display-serif">{system.title}</h3>
              <p class="system-subtitle">{system.subtitle}</p>
              <p class="system-copy">{system.copy}</p>
              <p class="system-deliverable"><span>交付结构</span>{system.deliverable}</p>
            </div>
            <span class="system-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="systems-action">
        <a href="/services" class="text-link">看完整交付方向 <span>→</span></a>
        <a href="/workflows" class="text-link muted">看工作流拆解 <span>→</span></a>
      </div>
    </section>

    <section id="proof" class="container section-block proof-section">
      <div class="section-heading proof-heading">
        <p class="section-kicker">PUBLIC EVIDENCE</p>
        <h2 class="display-serif section-title">公开工作台不是分散的入口，<br />而是持续工作的<strong>证据层。</strong></h2>
      </div>

      <div class="proof-grid">
        {proofs.map((proof) => (
          <a href={proof.href} class="proof-card scroll-reveal">
            <div class="proof-meta">
              <span>{proof.index}</span>
              <span>{proof.label}</span>
            </div>
            <strong class="display-serif">{proof.value}</strong>
            <p>{proof.copy}</p>
            <span class="proof-arrow">打开 <em>→</em></span>
          </a>
        ))}
      </div>
    </section>

    <section id="blog" class="container section-block writing-section">
      <div class="section-heading writing-heading">
        <div>
          <p class="section-kicker">WRITING</p>
          <h2 class="display-serif section-title">最近公开的判断与实验。</h2>
        </div>
        <a href="/blog" class="text-link">全部文章 <span>→</span></a>
      </div>

      <div class="blog-list">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date.toISOString()}
            tags={post.data.tags}
            slug={post.id}
            image={post.data.image}
          />
        ))}
      </div>
    </section>

    <section id="contact" class="container section-block contact-section">
      <div class="contact-card">
        <div class="contact-copy">
          <p class="section-kicker">START WITH ONE FLOW</p>
          <h2 class="display-serif section-title">带着一条正在重复的流程来，<br /><em>我们先判断它值不值得做。</em></h2>
          <p>不需要先写一份大需求。把现有的话术、表格、消息记录、流程描述或你希望改善的一个指标带来，就能从最小闭环开始聊。</p>
        </div>
        <div class="contact-action">
          <a href={contactHref} class="btn-primary contact-primary">发邮件拆流程 <span>→</span></a>
          <ul aria-label="开始沟通前可以准备的材料">
            <li><span>01</span>一段真实流程或原始材料</li>
            <li><span>02</span>谁负责、谁使用、哪里最卡</li>
            <li><span>03</span>跑通后如何判断有价值</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-right: 1.5rem;
    padding-left: 1.5rem;
  }

  .hero-section {
    padding-top: clamp(4.75rem, 9vw, 8rem);
    padding-bottom: clamp(3.5rem, 7vw, 6.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(19rem, 0.86fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-title {
    margin-top: 1.15rem;
    font-size: clamp(2.65rem, 5.8vw, 5.15rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-title em,
  .section-title em,
  .section-title strong {
    color: var(--color-accent);
    font-style: italic;
    font-weight: inherit;
  }

  .hero-lede {
    max-width: 39rem;
    margin-top: 1.55rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.35vw, 1.14rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  .hero-actions,
  .systems-action {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .hero-actions {
    margin-top: 2rem;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.85rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }

  .btn-primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-ink);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--text);
    color: var(--text);
    transform: translateY(-1px);
  }

  .hero-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-note i {
    width: 1.6rem;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-ticket {
    position: relative;
  }

  .hero-ticket::after {
    position: absolute;
    z-index: -1;
    right: -1.25rem;
    bottom: -1.25rem;
    width: 56%;
    height: 45%;
    border-right: 1px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
    content: '';
  }

  .section-block {
    padding-top: clamp(4.75rem, 8vw, 7.75rem);
    padding-bottom: clamp(1rem, 2.5vw, 2.5rem);
  }

  .section-heading {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .narrow-heading {
    max-width: 48rem;
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4.1vw, 3.55rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .problem-card {
    min-height: 18.5rem;
    padding: 1.3rem clamp(1.05rem, 2.2vw, 1.65rem) 1.55rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background 0.18s ease;
  }

  .problem-card:first-child {
    border-left: 1px solid var(--border);
  }

  .problem-card:hover {
    background: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .problem-meta,
  .proof-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .problem-meta span:first-child,
  .proof-meta span:first-child {
    color: var(--color-accent);
  }

  .problem-card h3 {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    font-size: clamp(1.6rem, 2.5vw, 2.15rem);
    line-height: 1.1;
  }

  .problem-card p {
    margin-top: 0.85rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .method-section {
    padding-top: clamp(5.5rem, 10vw, 9rem);
  }

  .method-heading,
  .systems-heading,
  .writing-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.7fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .method-heading > p,
  .systems-heading > p {
    max-width: 27rem;
    margin-bottom: 0.2rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .method-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .method-step {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(10rem, 0.4fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--border);
  }

  .method-index,
  .system-index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .method-step h3 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }

  .method-step p {
    max-width: 43rem;
    margin-top: 0.5rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .method-detail {
    justify-self: end;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
  }

  .systems-section {
    padding-top: clamp(5.5rem, 10vw, 9rem);
  }

  .systems-list {
    border-top: 1px solid var(--border);
  }

  .system-card {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: 2.1rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .system-card:hover {
    background: color-mix(in srgb, var(--surface) 68%, transparent);
    color: var(--text);
  }

  .system-card:hover h3,
  .system-card:hover .system-arrow {
    color: var(--color-accent);
  }

  .system-label,
  .system-subtitle,
  .system-deliverable span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .system-main h3 {
    margin-top: 0.55rem;
    font-size: clamp(1.55rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    transition: color 0.18s ease;
  }

  .system-subtitle {
    margin-top: 0.45rem;
  }

  .system-copy {
    max-width: 47rem;
    margin-top: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.78;
  }

  .system-deliverable {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .system-deliverable span {
    color: var(--color-accent);
  }

  .system-arrow {
    align-self: center;
    color: var(--text-muted);
    font-size: 1.35rem;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .system-card:hover .system-arrow {
    transform: translateX(4px);
  }

  .systems-action {
    margin-top: 1.5rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .text-link span {
    color: var(--color-accent);
    transition: transform 0.16s ease;
  }

  .text-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .text-link:hover span {
    transform: translateX(3px);
  }

  .text-link.muted {
