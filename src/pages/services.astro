---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { businessContact, services } from '../data/business';
---

<BaseLayout
  title="业务支撑 · siuser小伟"
  description="围绕 AI 外呼、流程自动化、内容系统与轻量内部工具的业务支撑范围、交付边界和适配条件。"
>
  <Header />

  <main class="flex-1 services-page">
    <section class="services-hero page-shell" aria-labelledby="services-title">
      <div class="hero-index" aria-hidden="true">
        <span>BUSINESS</span>
        <i></i>
        <span>2026</span>
      </div>

      <div class="hero-copy">
        <p class="section-kicker">Business support / working scope</p>
        <h1 id="services-title">先把业务动作<br /><em>写清楚</em>，再谈 AI。</h1>
        <p>
          这里不是一个“什么都能做”的能力清单。当前只讨论四类可落地的业务支撑：先确认问题、数据和责任边界，再把重复动作整理成可交接的流程、内容或工具。
        </p>
      </div>

      <aside class="hero-note" aria-label="合作原则">
        <p class="note-label">Working principle</p>
        <ol>
          <li><span>01</span>从一个具体问题开始</li>
          <li><span>02</span>交付物与人工节点同时设计</li>
          <li><span>03</span>不把可能的效果写成承诺</li>
        </ol>
      </aside>
    </section>

    <section class="service-ledger page-shell" aria-label="业务支撑清单">
      <header class="ledger-intro">
        <div>
          <p class="section-kicker">Offer ledger</p>
          <h2>四种支撑，不是四个万能模板。</h2>
        </div>
        <p>
          每一项都从输入、交付、人机边界开始。具体做法取决于你的场景、资料、系统权限和合规要求；如果这些还不清楚，先做问题梳理比急着开发更有价值。
        </p>
      </header>

      <div class="service-list">
        {services.map((service) => (
          <article id={service.id} class="service-entry" aria-labelledby={`${service.id}-title`}>
            <div class="entry-rail" aria-hidden="true">
              <span>{service.number}</span>
              <i></i>
              <small>OPEN</small>
            </div>

            <div class="entry-main">
              <header class="entry-heading">
                <div>
                  <p>{service.eyebrow}</p>
                  <h2 id={`${service.id}-title`}>{service.title}</h2>
                </div>
                <a class="entry-link" href={`mailto:${businessContact.email}?subject=${encodeURIComponent(`咨询：${service.title}`)}`}>
                  <span>讨论这个场景</span><b aria-hidden="true">↗</b>
                </a>
              </header>

              <p class="entry-summary">{service.summary}</p>

              <div class="entry-specs">
                <section class="spec-block">
                  <h3>你需要准备</h3>
                  <ul>
                    {service.inputs.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
                <section class="spec-block spec-deliverables">
                  <h3>会交付什么</h3>
                  <ul>
                    {service.deliverables.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
              </div>

              <aside class="human-fallback">
                <span>人工兜底</span>
                <p>{service.humanFallback}</p>
              </aside>

              <div class="fit-grid">
                <section class="fit-panel fit-panel-good">
                  <h3>适合从这里开始</h3>
                  <ul>
                    {service.fit.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
                <section class="fit-panel">
                  <h3>暂不适合</h3>
                  <ul>
                    {service.notFit.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="start-section page-shell" aria-labelledby="start-title">
      <div class="start-rule" aria-hidden="true"></div>
      <div class="start-grid">
        <div>
          <p class="section-kicker">Before we start</p>
          <h2 id="start-title">先发一页问题说明，<br />比先要一份报价更有效。</h2>
        </div>
        <div class="start-copy">
          <p>如果你要讨论其中一类场景，邮件里可先写下面四件事。信息不必完整，但越接近真实工作，判断越快。</p>
          <ol>
            {businessContact.briefChecklist.map((item, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>
            ))}
          </ol>
          <div class="start-actions">
            <a class="primary-action" href={`mailto:${businessContact.email}?subject=${encodeURIComponent('咨询：业务支撑场景')}`}>发起场景讨论 <span>↗</span></a>
            <a class="secondary-action" href="/workflows">先看工作流 <span>→</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .services-page {
    padding-bottom: 1px;
  }

  .page-shell {
    width: min(100% - 3rem, var(--container-max));
    margin: 0 auto;
  }

  .services-hero {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1.18fr) minmax(16rem, 0.56fr);
    gap: clamp(1.5rem, 5vw, 5.5rem);
    align-items: end;
    min-height: min(43rem, calc(100vh - 4.5rem));
    padding-top: clamp(7rem, 12vw, 11rem);
    padding-bottom: clamp(4rem, 8vw, 7.25rem);
  }

  .hero-index {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .hero-index i {
    width: 1px;
    min-height: 7rem;
    margin: 1rem 0;
    background: var(--color-accent);
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-copy h1 {
    margin-top: 1rem;
    max-width: 10ch;
    font-size: clamp(3.1rem, 6.6vw, 5.9rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero-copy h1 em {
    color: var(--color-accent);
  }

  .hero-copy > p:last-child {
    max-width: 37rem;
    margin-top: 1.85rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  .hero-note {
    position: relative;
    padding: 1.25rem 1.35rem 1.35rem;
    border-top: 2px solid var(--color-accent);
    border-bottom: 1px solid var(--border);
  }

  .note-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-note ol {
    display: grid;
    gap: 0;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-note li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.76rem 0;
    border-top: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .hero-note li span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
  }

  .service-ledger {
    padding-bottom: clamp(5rem, 12vw, 10rem);
  }

  .ledger-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.65fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    padding: 1.5rem 0 3.5rem;
    border-top: 1px solid var(--border-strong);
  }

  .ledger-intro h2,
  .start-grid h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.85rem, 3.2vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .ledger-intro > p {
    max-width: 31rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .service-list {
    border-top: 1px solid var(--border);
  }

  .service-entry {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: clamp(1.35rem, 4.5vw, 4.5rem);
    padding: clamp(3.4rem, 7vw, 5.75rem) 0;
    scroll-margin-top: 5.25rem;
    border-bottom: 1px solid var(--border);
  }

  .entry-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.14em;
  }

  .entry-rail i {
    width: 1px;
    flex: 1 1 auto;
    min-height: 4rem;
    background: color-mix(in srgb, var(--color-accent) 34%, var(--border));
  }

  .entry-rail small {
    color: var(--text-muted);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
  }

  .entry-main {
    min-width: 0;
  }

  .entry-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .entry-heading p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .entry-heading h2 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 3.7vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .entry-link,
  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .entry-link {
    margin-top: 0.25rem;
    padding: 0.55rem 0 0.55rem 0.75rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-secondary);
  }

  .entry-link b {
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 400;
    transition: transform 0.15s ease;
  }

  .entry-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .entry-link:hover b { transform: translate(2px, -2px); }

  .entry-summary {
    max-width: 52rem;
    margin-top: 1.6rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.13rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  .entry-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.45rem;
    border: 1px solid var(--border);
    background: var(--border);
  }

  .spec-block {
    padding: 1.35rem 1.5rem 1.45rem;
    background: var(--bg);
  }

  .spec-block h3,
  .fit-panel h3 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .spec-block h3::before {
    content: '—';
    margin-right: 0.45rem;
    color: var(--color-accent);
  }

  .spec-block ul,
  .fit-panel ul {
    display: grid;
    gap: 0.62rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .spec-block li,
  .fit-panel li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .spec-block li::before,
  .fit-panel li::before {
    position: absolute;
    left: 0;
    color: var(--color-accent);
    content: '·';
    font-size: 1.1em;
  }

  .spec-deliverables {
    background: var(--surface);
  }

  .human-fallback {
    display: grid;
    grid-template-columns: 8.1rem minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1px;
    padding: 1.2rem 1.5rem 1.3rem;
    border: 1px solid var(--border);
    border-top: 0;
    background: color-mix(in srgb, var(--surface-strong) 47%, var(--bg));
  }

  .human-fallback span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .human-fallback p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.72;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .fit-panel {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .fit-panel-good { border-color: color-mix(in srgb, var(--color-accent) 45%, var(--border)); }
  .fit-panel-good h3 { color: var(--color-accent); }

  .start-section {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .start-rule {
    height: 2px;
    background: var(--color-accent);
  }

  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(19rem, 0.8fr);
    gap: clamp(2.5rem, 9vw, 10rem);
    padding: clamp(2.4rem, 5vw, 4.25rem) 0 0;
  }

  .start-copy > p {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .start-copy ol {
    display: grid;
    gap: 0;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .start-copy li {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .start-copy li span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
  }

  .start-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.65rem;
  }

  .primary-action,
  .secondary-action {
    min-height: 2.8rem;
    padding: 0 1rem;
    border: 1px solid var(--border-strong);
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .primary-action {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .primary-action:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-ink);
  }

  .primary-action span,
  .secondary-action span {
    font-size: 1rem;
  }

  .secondary-action { color: var(--text-secondary); }
  .secondary-action:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 880px) {
    .services-hero {
      grid-template-columns: 2.8rem minmax(0, 1fr);
      min-height: 0;
    }

    .hero-note {
      grid-column: 2;
      max-width: 33rem;
    }

    .service-entry { grid-template-columns: 2.8rem minmax(0, 1fr); }
    .ledger-intro, .start-grid { grid-template-columns: 1fr; }
    .ledger-intro { gap: 1.1rem; }
  }

  @media (max-width: 640px) {
    .page-shell { width: min(100% - 2rem, var(--container-max)); }

    .services-hero {
      grid-template-columns: 1.1rem minmax(0, 1fr);
      gap: 1rem;
      padding-top: 6.5rem;
      padding-bottom: 4rem;
    }

    .hero-index {
      font-size: 0.54rem;
      letter-spacing: 0.1em;
    }

    .hero-index i { min-height: 4rem; }
    .hero-copy h1 { font-size: clamp(2.7rem, 13vw, 4rem); }
    .hero-note { grid-column: 2; }
    .service-entry { grid-template-columns: 1.1rem minmax(0, 1fr); gap: 1rem; }
    .entry-rail { font-size: 0.58rem; }
    .entry-rail small { display: none; }
    .entry-heading { display: block; }
    .entry-link { margin-top: 1rem; }
    .entry-specs, .fit-grid { grid-template-columns: 1fr; }
    .entry-specs { gap: 1px; }
    .human-fallback { grid-template-columns: 1fr; gap: 0.65rem; }
    .start-grid h2 br { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-link b { transition: none; }
  }
</style>
