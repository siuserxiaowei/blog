---
export interface RunSheetField {
  label: string;
  value: string;
}

interface Props {
  code?: string;
  eyebrow?: string;
  title: string;
  summary?: string;
  fields: RunSheetField[];
  status?: string;
  note?: string;
}

const {
  code = 'FLOW-01',
  eyebrow = '流程运行单 · 示意',
  title,
  summary,
  fields,
  status = '观察中',
  note = '从现场到系统'
} = Astro.props;
---

<aside class="run-sheet" aria-label={`${title}流程运行单示意`}>
  <div class="run-sheet-head">
    <div>
      <p class="run-sheet-eyebrow">{eyebrow}</p>
      <p class="run-sheet-code">{code}</p>
    </div>
    <span class="run-sheet-status"><i></i>{status}</span>
  </div>

  <div class="run-sheet-title">
    <h2>{title}</h2>
    {summary && <p>{summary}</p>}
  </div>

  <dl class="run-sheet-fields">
    {fields.map((field) => (
      <div>
        <dt>{field.label}</dt>
        <dd>{field.value}</dd>
      </div>
    ))}
  </dl>

  <div class="run-sheet-foot">
    <span>{note}</span>
    <span aria-hidden="true">↗</span>
  </div>
</aside>

<style>
  .run-sheet {
    position: relative;
    overflow: hidden;
    padding: clamp(1.15rem, 2.3vw, 1.6rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 26%),
      var(--surface);
    box-shadow: var(--shadow-card);
  }

  .run-sheet::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 5.5rem;
    height: 3px;
    background: var(--color-accent);
    content: '';
  }

  .run-sheet-head,
  .run-sheet-foot,
  .run-sheet-fields > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .run-sheet-eyebrow,
  .run-sheet-code,
  .run-sheet-status,
  .run-sheet-fields dt,
  .run-sheet-foot {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .run-sheet-eyebrow {
    color: var(--text-muted);
  }

  .run-sheet-code {
    margin-top: 0.25rem;
    color: var(--color-accent);
  }

  .run-sheet-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding: 0.32rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--border));
    color: var(--color-accent);
  }

  .run-sheet-status i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 99px;
    background: currentColor;
  }

  .run-sheet-title {
    padding: 1.5rem 0 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .run-sheet-title h2 {
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    line-height: 1.12;
  }

  .run-sheet-title p {
    max-width: 26rem;
    margin-top: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .run-sheet-fields {
    margin: 0;
  }

  .run-sheet-fields > div {
    min-height: 2.85rem;
    border-bottom: 1px solid var(--border);
  }

  .run-sheet-fields dt {
    color: var(--text-muted);
  }

  .run-sheet-fields dd {
    margin: 0;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 500;
    text-align: right;
  }

  .run-sheet-foot {
    padding-top: 0.9rem;
    color: var(--text-muted);
  }

  .run-sheet-foot span:last-child {
    color: var(--color-accent);
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .run-sheet-fields > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.7rem 0;
    }

    .run-sheet-fields dd {
      text-align: left;
    }
  }
</style>
